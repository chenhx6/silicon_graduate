# Large and reproducible source artifacts
*.pdf
*.zip
*.7z
*.root
*.spe
*.mat
*.npy

# Raw originals stay local; keep one empty root marker for the path contract.
raw/**
!raw/.gitkeep
# Temporary and generated caches
tmp/
__pycache__/
*.pyc
.trash/
.qmd/

# Local NNDC MCP runtime and response cache
tools/nndc_mcp/.cache/
tools/nndc_mcp/.venv/

# Obsidian machine-local state
.codex/
.obsidian/
AGENTS.local.md
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/plugins/

# Local prompt drafts
prompt/
docs/

# Docker-local daily-learning runtime state
tmp/docker-daily-learning-daemon.*
outputs/learning-milestones/2026-09-one-month-scheduler.jsonl
outputs/learning-milestones/2026-09-one-month-scheduler-state.json

# Local dissertation extraction and visual-QA scratch directories
/.degree-read-tmp-*/
/.degree-read-visual-*/

# Accidental session-id copy saved under the plans directory
outputs/plans/2026-09-10-degree-dissertation-corpus-ingest copy.md

# Daily runner telemetry and derivative screenshot crops; keep run.json, prompts and reports
outputs/learning-daily/*-run-*/events.jsonl
outputs/learning-daily/*-run-*/continuation-*-events.jsonl
outputs/learning-daily/*-run-*/stderr.log
outputs/learning-daily/*-run-*/continuation-*-stderr.log
outputs/learning-daily/*-run-*/last-message.md
outputs/learning-daily/*-run-*/continuation-*-last-message.md
outputs/learning-daily/*-run-*/*.png
outputs/learning-daily/*-run-*/day*-figures/
