        "titles": [
          {
            "title": "γ-ray spectroscopy of the A=23, T=1/2 nuclei 23Na and 23Mg: High-spin states, mirror symmetry, and applications to nuclear astrophysical reaction rates"
          }
        ],
        "publisher": "American Physical Society",
        "container": {},
        "publicationYear": 2013,
