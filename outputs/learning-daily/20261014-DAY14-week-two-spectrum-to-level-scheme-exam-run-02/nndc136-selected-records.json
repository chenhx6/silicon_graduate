        {
          "line": 3,
          "text": "136PR  H TYP=FUL$AUT=E.A. MCCUTCHAN$CIT=NDS 152, 331 (2018)$CUT=1-Apr-2018$     "
        },
        {
          "line": 4,
          "text": "136PR c  1996Pe12: E({+30}Si)=125 MeV. Measured E|g, I|g, |g|g, |g(|q),         "
        },
        {
          "line": 5,
          "text": "136PR2c  |g|g(|q)(DCO), |g(t), |g(|q,H,t) using GASP array of 40 Ge detectors   "
        },
        {
          "line": 6,
          "text": "136PR3c  and 80 BGO inner-ball detectors. Includes {+122}Sn({+19}F,5n|g)        "
        },
        {
          "line": 7,
          "text": "136PR4c  E({+19}F)=84 MeV and {+136}Ce(p,n|g) E(p)=14 MeV                       "
        },
        {
          "line": 8,
          "text": "136PR c  1993Ba42: {+122}Sn({+19}F,5n|g) E=76-88 MeV. Measured E|g, I|g,        "
        },
        {
          "line": 9,
          "text": "136PR2c  |g(|q) |g(t) using HPGe detectors; deduced g factor with TDPAD         "
        },
        {
          "line": 10,
          "text": "136PR3c  technique.                                                             "
        },
        {
          "line": 11,
          "text": "136PR c  Earlier works: 1992Ol03, 1987Dr12                                      "
        },
        {
          "line": 12,
          "text": "136PR cL E$From a least-squares fit to E|g, by evaluator.                       "
