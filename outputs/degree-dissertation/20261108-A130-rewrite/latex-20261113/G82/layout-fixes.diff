 \begin{equation}\label{eq:2-3-2}
-|j^2; J=0, M=0\rangle = \frac{1}{\sqrt{2(2j+1)}} \sum_{m=-j}^j (-1)^{j-m} c_{jm}^\dagger c_{j,-m}^\dagger |0\rangle = \frac{1}{\sqrt{\Omega}} \sum_{m>0} (-1)^{j-m} c_{jm}^\dagger c_{j,-m}^\dagger |0\rangle,
+\begin{aligned}
+|j^2; J=0, M=0\rangle &= \frac{1}{\sqrt{2(2j+1)}} \sum_{m=-j}^j (-1)^{j-m} c_{jm}^\dagger c_{j,-m}^\dagger |0\rangle \\
+&= \frac{1}{\sqrt{\Omega}} \sum_{m>0} (-1)^{j-m} c_{jm}^\dagger c_{j,-m}^\dagger |0\rangle,
+\end{aligned}
 \end{equation}
