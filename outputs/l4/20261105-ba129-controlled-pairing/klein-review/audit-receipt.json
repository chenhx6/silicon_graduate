  "findings": [
    {
      "id": "KLV1-NORMALIZATION",
      "source": "A12-A14, PDF p.25; TeX 1449-1463",
      "severity_for_adoption": "blocking",
      "finding": "With the A12 definition, A13 maps Lambda_a*Omega_a to Lambda_a^2*Omega_a. A reciprocal is a one-block scalar correction only; not a validated nonlinear iteration."
    },
    {
      "id": "KLV1-MULTIPLIER",
      "source": "A18/A21-A22, PDF pp.26-27; TeX 1494,1525,1529",
      "severity_for_adoption": "blocking",
      "finding": "A18 and A21 are valid; full-space H=Omega*Theta does not follow. Occupied and complementary multiplier blocks have opposite signs."
    },
    {
      "id": "KLV1-SUBSTITUTION",
      "source": "A18/A22-A23, PDF pp.26-27; TeX 1494,1529,1533",
      "severity_for_adoption": "blocking",
      "finding": "Literal substitution gives 2H-{R,H}/Omega, not printed H-{R,H}/Omega. Correcting the factor alone does not validate A22."
    },
    {
      "id": "KLV1-STATIONARITY",
      "source": "A15/A23, PDF pp.26-27; TeX 1472,1533",
      "severity_for_adoption": "blocking",
      "finding": "A23 annihilates H diagonal blocks in the projector decomposition, whereas commutator stationarity annihilates off-diagonal blocks; both imply H=0."
    },
    {
      "id": "KLV1-TANGENT",
      "source": "A25-A28, PDF p.27; TeX 1540-1561",
      "severity_for_adoption": "blocking",
      "finding": "The A26 update fails the correct linearized constraint A27 and generally even A28. A28 by itself is necessary but insufficient."
    },
    {
      "id": "KLV1-FIXED-MATRIX-MAPPING",
      "source": "Section II, Appendix A, and paired_single_j_nambu.py",
      "severity_for_adoption": "physical-interpretation-unresolved",
      "finding": "Arbitrary Nambu eigenvectors or spectral projectors do not acquire CFP particle-number and completeness constraints. Frozen K(t) is not a zero-core-rotation continuation."
    }
  ],
